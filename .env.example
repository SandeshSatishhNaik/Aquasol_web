# Copy this file to .env for local builds. On Cloudflare Pages, set the same names under
# Settings > Variables and secrets. Both values end up readable in the built site.

# Inbox that receives messages from the contact form (opens the visitor's email app).
VITE_CONTACT_EMAIL=

# Public base URL of the R2 bucket holding the videos and large photos, for example
# https://pub-xxxxxxxx.r2.dev (no trailing slash). Leave empty to serve them from public/assets.
VITE_MEDIA_BASE=
